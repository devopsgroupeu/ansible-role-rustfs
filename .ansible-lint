profile: production
# Molecule playbooks include the role by its checkout directory name, which
# ansible-lint >= 26.11 no longer resolves on its own.
mock_roles:
  - ansible-role-rustfs
exclude_paths:
  - .github/
  - .ansible-lint
  - venv/
  - .git/
warn_list:
  - no-handler
  - var-spacing
  - var-naming
  - yaml[comments-indentation]
skip_list:
  - experimental
  - yaml[line-length]
enable_list:
  - no-log-password
  - loop-var-prefix
